# ==========================================
# ❄️ Frosty AI Discord Bot - Environment Configuration
# ==========================================

# 1. Discord Bot Credentials
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# 2. AI Provider Selection
# Options: "gemini" (recommended), "groq", "openai"
AI_PROVIDER=gemini

# 3. Google Gemini Configuration (Primary Recommended)
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 4. Groq Configuration (Fast Alternative)
# Get your Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 5. OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 6. Database & Bot Settings
CHROMA_PATH=./frosty_brain
COMMAND_PREFIX=!
# Comma-separated Discord User IDs for bot administrators (access to /reindex)
ADMIN_USER_IDS=
